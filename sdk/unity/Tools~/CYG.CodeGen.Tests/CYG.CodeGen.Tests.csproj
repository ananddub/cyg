<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/Sim/Core/*.cs" LinkBase="Runtime/Core" />
    <Compile Include="../../Runtime/Sim/Math/*.cs" LinkBase="Runtime/Math" />
    <Compile Include="../../Runtime/Sim/Physics3D/*.cs" LinkBase="Runtime/Physics3D" />
    <ProjectReference Include="../CYG.CodeGen/CYG.CodeGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
