{
  "name": "cyg-language",
  "displayName": "CYG Language",
  "description": "CookYourGame deterministic simulation DSL: syntax highlighting, diagnostics, completion, hover, navigation and rename.",
  "version": "0.1.0",
  "publisher": "cookyourgame",
  "license": "MIT",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "cyg",
    "cookyourgame",
    "deterministic",
    "ecs",
    "dsl"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:cyg"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cyg",
        "aliases": [
          "CYG",
          "CookYourGame DSL"
        ],
        "extensions": [
          ".cyg"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cyg",
        "scopeName": "source.cyg",
        "path": "./syntaxes/cyg.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "cyg.restartServer",
        "title": "Restart Language Server",
        "category": "CYG"
      }
    ],
    "configuration": {
      "title": "CYG",
      "properties": {
        "cyg.lsp.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to `CYG.Lsp.dll`. Leave empty to use the bundled server or the Release build next to this extension."
        },
        "cyg.lsp.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "markdownDescription": "Path to the `dotnet` executable used to launch the language server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "scripts": {
    "build:server": "dotnet publish ../CYG.Lsp/CYG.Lsp.csproj -c Release -o server",
    "package": "vsce package --allow-missing-repository"
  }
}
