<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CYG.Headless.Match</AssemblyName>
    <RootNamespace>CookYourGame.Sim.Headless</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/Sim/Core/**/*.cs" LinkBase="Runtime/Core" />
    <Compile Include="../../Runtime/Sim/Math/**/*.cs" LinkBase="Runtime/Math" />
    <Compile Include="../../Runtime/Sim/World/**/*.cs" LinkBase="Runtime/World" />
    <Compile Include="../../Runtime/Sim/Physics3D/**/*.cs" LinkBase="Runtime/Physics3D" />
    <Compile Include="../../Runtime/Sim/Physics2D/**/*.cs" LinkBase="Runtime/Physics2D" />
    <Compile Include="../../Runtime/Sim/Navigation/**/*.cs" LinkBase="Runtime/Navigation" />
    <Compile Include="../../Runtime/Sim/Netcode/*.cs" LinkBase="Runtime/Netcode" />
  </ItemGroup>
</Project>
