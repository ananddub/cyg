<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CYG.DeterminismLab.Client</RootNamespace>
    <AssemblyName>CYG.DeterminismLab.Client</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.32" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../Runtime/Sim/Math/*.cs" LinkBase="Sim/Math" />
    <Compile Include="../../../Runtime/Sim/Physics3D/*.cs" LinkBase="Sim/Physics3D" />
    <Compile Include="../../../Runtime/Sim/Core/*.cs" LinkBase="Sim/Core" />
  </ItemGroup>

</Project>
