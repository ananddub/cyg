{
    "name": "@cyg/core-ts",
    "version": "1.6.0",
    "description": "Typesafe CYG client core — TypeScript surface over the shared cyg-core-rs WASM core.",
    "license": "MIT",
    "type": "module",
    "main": "dist/cyg.cjs",
    "module": "dist/cyg-core.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/cyg-core.mjs",
            "require": "./dist/cyg.cjs"
        },
        "./schema": {
            "types": "./dist/schema.d.ts",
            "import": "./dist/cyg-core.mjs"
        }
    },
    "files": ["dist"],
    "scripts": {
        "build": "node build.mjs",
        "typecheck": "tsc --noEmit",
        "test": "node --test test/*.test.mjs"
    },
    "devDependencies": {
        "esbuild": "^0.24.0",
        "typescript": "^5.6.0"
    }
}
