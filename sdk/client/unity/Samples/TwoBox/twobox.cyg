namespace CookYourGame.Sim.TwoBox;

// ECS component for player box state
component BoxPlayer : 1010 {
    player_ref Player;
    Int32 Score;
}

// ECS component for box movement state
component BoxMovement : 1011 {
    FP Speed;
    FPVector3 Velocity;
}

// ECS component for golden gem target
component GemTarget : 1012 {
    FP Radius;
    FPVector3 Position;
    Boolean IsActive;
}

// View event emitted when the gem is collected
event GemCollected : 1000001 {
    entity_ref Collector;
    player_ref Player;
    FPVector3 Position;
    Int32 NewScore;
}
