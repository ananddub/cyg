{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "cyg",
      "camelcase": "Cyg",
      "title": "CYG",
      "scope": "source.cyg",
      "file-types": ["cyg"],
      "class-name": "TreeSitterCyg"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the CYG deterministic simulation schema language",
    "authors": [
      {
        "name": "CookYourGame"
      }
    ]
  },
  "bindings": {
    "c": true,
    "node": false,
    "rust": false,
    "swift": false,
    "go": false
  }
}
