  "cards": [
    {
      "dot": "emerald",
      "title": "Ingress & Client SDKs",
      "items": [
        "Godot, Unity, and Web clients connect over single-port WS or WebRTC UDP",
        "LoopTransport fans in all transports into unified Inbound packet stream",
        "ReliableLane guarantees ordered critical events with bounded backoff"
      ]
    },
    {
      "dot": "cyan",
      "title": "Authoritative Room Execution",
      "items": [
        "GameServer runs fixed 60Hz/128Hz tick loops without GC pauses",
        "Guest rooms run inside Wasmtime sandbox with epoch watchdog protection",
        "Physics (Rapier2D/3D) and Spatial AOI run natively on host via batched ABI"
      ]
    },
    {
      "dot": "amber",
      "title": "Binary State Sync (OXS2)",
      "items": [
        "engine-schema encodes variable-length delta bitmasks per entity",
        "Clients receive 109-byte delta snapshots at 60Hz for smooth interpolation",
        "Dirty field tracking avoids resending unchanged properties"
      ]
    },
    {
      "dot": "rose",
      "title": "Persistence & Control Plane",
      "items": [
        "engine-bus bridges game loop to async control plane via lock-free channels",
        "SurrealDB stores room snapshots, rehydration state, and match telemetry",
        "engine-agones exposes Kubernetes GameServer health and allocation endpoints"
      ]
    }
  ]
}
